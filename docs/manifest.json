{
  "id": "/",
  "name": "The Scriptwriter",
  "short_name": "Scriptwriter",
  "description": "A free, open-source stage play editor. No accounts, no installs — just open and start writing.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#1a1a18",
  "theme_color": "#1a1a18",
  "orientation": "any",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [".json"],
        "text/plain": [".fountain", ".fdx"],
        "text/x-fountain": [".fountain"],
        "application/xml": [".fdx"]
      },
      "icons": [
        { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }
      ],
      "launch_type": "single-client"
    }
  ],
  "shortcuts": [
    {
      "name": "New Script",
      "short_name": "New",
      "description": "Start a brand new stage play",
      "url": "./?action=new"
    },
    {
      "name": "Open File",
      "short_name": "Open",
      "description": "Open an existing script from your computer",
      "url": "./?action=open"
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Editing a stage play in The Scriptwriter"
    },
    {
      "src": "screenshot-narrow.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile editing"
    }
  ],
  "categories": ["productivity", "utilities"],
  "lang": "en-US",
  "dir": "ltr"
}
